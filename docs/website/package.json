{
  "name": "@docs/website",
  "version": "12.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/generate-api-docs.mts && docusaurus build",
    "build-dev": "NODE_ENV=development docusaurus build",
    "clear": "docusaurus clear",
    "deploy": "carlin deploy static-app",
    "dev": "pnpm start",
    "docusaurus": "docusaurus",
    "generate-api-docs": "node scripts/generate-api-docs.mts",
    "serve": "docusaurus serve",
    "start": "NODE_OPTIONS=--max-old-space-size=4096 docusaurus start",
    "swizzle": "docusaurus swizzle",
    "write-heading-ids": "docusaurus write-heading-ids",
    "write-translations": "docusaurus write-translations"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/faster": "^3.10.2",
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/plugin-sitemap": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "@docusaurus/theme-mermaid": "^3.10.2",
    "@mdx-js/react": "3.1.1",
    "force-graph": "^1.52.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-force-graph-2d": "^1.29.2",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@docusaurus/types": "^3.10.2",
    "carlin": "workspace:^",
    "docusaurus-plugin-llms": "^0.6.1",
    "typedoc": "^0.28.20",
    "typedoc-docusaurus-theme": "^1.4.3",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "~6.0.3"
  }
}
