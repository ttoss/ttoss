{
  "name": "@ttoss/email-marketing",
  "version": "0.3.1",
  "description": "Runner-agnostic email marketing engine: suppression list, one-click unsubscribe, sender domains and delivery events, with pluggable providers (Amazon SES)",
  "keywords": [
    "email",
    "email-marketing",
    "ses",
    "ttoss",
    "unsubscribe"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ttoss/ttoss.git",
    "directory": "packages/email-marketing"
  },
  "license": "MIT",
  "author": "ttoss",
  "contributors": [
    "Pedro Arantes <pedro@arantespp.com> (https://arantespp.com)"
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./ses": "./src/ses/index.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "jest --projects tests/unit"
  },
  "devDependencies": {
    "@aws-sdk/client-sesv2": "^3.1169.0",
    "@ttoss/config": "workspace:^",
    "jest": "^30.5.2",
    "tsdown": "^0.23.1"
  },
  "peerDependencies": {
    "@aws-sdk/client-sesv2": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sesv2": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.mts"
      },
      "./ses": {
        "import": "./dist/ses/index.mjs",
        "require": "./dist/ses/index.cjs",
        "types": "./dist/ses/index.d.mts"
      }
    },
    "provenance": true
  }
}
